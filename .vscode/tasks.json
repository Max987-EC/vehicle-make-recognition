{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "01 建立與檢查環境",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "setup.cmd"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
